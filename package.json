{
  "name": "astral-heresy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "python3 scripts/serve_local.py 7666 --directory dist",
    "validate": "npm test && npm run test:browser",
    "check:docs": "perfect-doc check --offline --config perfect-doc.toml",
    "test": "node scripts/validate_fast.mjs",
    "test:browser": "npm run build && playwright test --config=playwright.config.mjs",
    "test:performance": "playwright test --config=playwright.performance.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": ">=1.63.0",
    "acorn": ">=8.18.0"
  }
}
